[Unit]
Description=Webhook github listener
After=network.target

[Service]
Type=simple
User=developer
Group=developer
WorkingDirectory=/home/developer/Infra4BeautyAI/webhook_listener
ExecStart=/bin/python3 /home/developer/Infra4BeautyAI/webhook_listener/listener.py
Restart=always

[Install]
WantedBy=multi-user.target